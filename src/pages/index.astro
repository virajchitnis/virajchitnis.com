---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ContactForm from '../components/ContactForm.astro';
import { getEntry, render } from 'astro:content';

const profileEntry = await getEntry('profile', 'profile');
if (!profileEntry) throw new Error('Missing src/content/profile.md entry');
const { name, jobTitle, tagline, metaDescription, links } = profileEntry.data;
const { Content } = await render(profileEntry);

const pageTitle = `${name} — ${jobTitle}`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  jobTitle,
  description: metaDescription,
  image: new URL('/og-image.png', Astro.site).toString(),
  url: new URL('/', Astro.site).toString(),
  sameAs: links.map((link) => link.url),
  knowsAbout: ['Software Engineering', 'Web Development', 'AI-Assisted Software Development'],
};
---

<BaseLayout title={pageTitle} description={metaDescription} siteName={name} structuredData={structuredData}>
  <div class="page">
    <Hero name={name} tagline={tagline}>
      <Content />
    </Hero>
    <SocialLinks links={links} />
    <ContactForm />
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }
</style>
